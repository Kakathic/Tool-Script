<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- miuix-blur yêu cầu Android 13 (API 33) còn app hỗ trợ từ API 24: cho phép gộp, code chỉ bật blur khi máy từ API 33 (isRuntimeShaderSupported). -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <!-- Quyền bộ nhớ: xin lúc khởi động, từ chối thì thoát app.
         Android 11+ (API 30+): "Truy cập tất cả tệp" (MANAGE_EXTERNAL_STORAGE).
         Android 7 đến 10 (API 24-29): READ/WRITE_EXTERNAL_STORAGE xin lúc chạy; từ Android 11 hai quyền này không còn dùng nữa. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Thông báo hệ thống (shell = "notice"): chỉ xin khi dùng tới, Android 13+ (máy thấp hơn không cần xin) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Backend adb kết nối về chính máy qua localhost -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Quyền truy cập mạng cục bộ của Android 17: chỉ áp dụng cho app target 37 trở lên, với targetSdk 28 hệ thống không đòi.
         Giữ khai báo để khi nâng targetSdk lại thì không sót. Máy thấp hơn bỏ qua quyền này. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ToolScript.Starting">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Trung tâm lỗi: chạy ở tiến trình riêng để vẫn hiện được khi app chính văng -->
        <activity
            android:name=".crash.CrashActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:process=":crash"
            android:theme="@style/Theme.ToolScript" />
    </application>
</manifest>
