#!/system/bin/sh
# Thử script trong bin: ghi giá trị vào $STATE_DIR/<id> (giống hàm state_set trong env.sh).
# Dùng: state-set <id> <giá trị>
case "$1" in
  ""|*/*|.*) echo "id không hợp lệ: '$1'" >&2; exit 2 ;;
esac
[ $# -ge 2 ] || { echo "dùng: state-set <id> <giá trị>" >&2; exit 2; }
[ -n "$STATE_DIR" ] || { echo "thiếu biến STATE_DIR (env.sh chưa được nạp)" >&2; exit 3; }
echo "$2" > "$STATE_DIR/$1" || exit 1
echo "đã lưu $1 = $2"
