<resources>
    <!-- Giao diện chính: toàn bộ UI do Compose/Miuix vẽ -->
    <style name="Theme.ToolScript" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash hệ thống (rất ngắn), sau đó chuyển sang Theme.ToolScript -->
    <style name="Theme.ToolScript.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.ToolScript</item>
    </style>
</resources>
