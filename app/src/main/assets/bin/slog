#!/system/bin/sh
# kakathic

if [ "$1" = '-h' ] || [ "$1" = '--help' ] || [ -z "$1" ]; then
    echo "Use: slog key 1" >&2
    echo "Delete: slog -d key" >&2
    exit 1
fi

[ -d "$STATE_DIR" ] || mkdir -p "$STATE_DIR"

if [ "$1" = "-d" ] || [ "$1" = "--delete" ]; then
    if [ -z "$2" ]; then
        echo "Delete: slog -d key" >&2
        exit 1
    fi
    rm -f "$STATE_DIR/$2"
elif [ "$2" ]; then
    printf '%s\n' "$2" > "$STATE_DIR/$1"
else
    : > "$STATE_DIR/$1"
fi
