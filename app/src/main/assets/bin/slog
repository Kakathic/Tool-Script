#!/system/bin/sh
# kakathic

if [ "$1" == '-h' ] || [ "$1" == '--help' ] || [ -z "$1" ]; then
    echo "Use: slog key 1" >&2
    echo "Delete: slog -d key" >&2
    exit 1
fi

[ -d "$STATE_DIR" ] || mkdir -p "$STATE_DIR"

if [ "$2" ]; then
    if [ "$1" == "-d" ] || [ "$1" == "--delete" ]; then
    [ -f "$STATE_DIR/$2" ] && rm -f "$STATE_DIR/$2"
    else
    echo "$2" > "$STATE_DIR/$1"
    fi
else
    [ "$1" ] && echo -n > "$STATE_DIR/$1"
fi